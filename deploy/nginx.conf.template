server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Never expose dotfiles (except the standard ACME challenge path).
    location ~ /\.(?!well-known(?:/|$)) {
        deny all;
        access_log off;
        log_not_found off;
    }

    # Keep common secret, database, backup, and diagnostic artifacts private.
    location ~* \.(?:env|pem|key|p12|pfx|sqlite|db|bak|backup|log)$ {
        deny all;
        access_log off;
        log_not_found off;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    location ~* \.(?:css|js|png|jpg|jpeg|gif|svg|webp|ico|woff2?)$ {
        expires 5m;
        add_header Cache-Control "public";
        try_files $uri =404;
    }
}
